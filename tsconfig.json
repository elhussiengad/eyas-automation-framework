{
    "compilerOptions": {
          "target": "ES2022",
          "module": "commonjs",
          "lib": ["ES2022", "DOM"],
          "strict": true,
          "esModuleInterop": true,
          "skipLibCheck": true,
          "forceConsistentCasingInFileNames": true,
          "resolveJsonModule": true,
          "baseUrl": ".",
          "paths": {
                  "@pages/*": ["src/pages/*"],
                  "@api/*": ["src/api/*"],
                  "@fixtures/*": ["src/fixtures/*"],
                  "@utils/*": ["src/utils/*"],
                  "@data/*": ["src/data/*"]
          }
    },
    "include": ["src/**/*", "tests/**/*", "playwright.config.ts"]
}
